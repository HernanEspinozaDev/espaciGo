{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Normalización cromática sobre el diseño Next existente en main. No sustituye layouts, tipografía, espaciado ni componentes.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.643, 0.278, 0.192],
        "hex": "#a44731"
      }
    },
    "primary-hover": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.518, 0.208, 0.133],
        "hex": "#843522"
      }
    },
    "primary-active": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.439, 0.165, 0.106],
        "hex": "#702a1b"
      }
    },
    "primary-soft": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.961, 0.89, 0.859],
        "hex": "#f5e3db"
      }
