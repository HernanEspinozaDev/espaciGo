{
  "name": "espacigo-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.21.0 <27"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src/app/page.tsx src/app/layout.tsx next.config.ts eslint.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tooling/*.test.mjs",
    "format:check": "prettier --check .",
    "start:local": "mkdir -p .next/standalone/public && cp -R public/. .next/standalone/public/ && HOSTNAME=127.0.0.1 PORT=4201 node .next/standalone/server.js",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm format:check && pnpm build"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.8.1",
    "typescript": "^5"
  }
}
