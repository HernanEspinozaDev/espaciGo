{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node tooling/start-local-ssr.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:server-gateway": "node --test tooling/server-api-gateway.test.mjs tooling/bounded-request-body.test.mjs",
    "test:iap-assertion": "node --test tooling/iap-assertion.test.mjs",
    "serve:ssr:frontend": "node dist/frontend/server/server.mjs",
    "e2e": "playwright test --config=playwright.config.cjs",
    "api:generate": "openapi-ts && node ../scripts/normalize-openapi-generated.mjs src/generated/api",
    "api:check": "npm run api:generate && node --test tooling/openapi-attribute-pattern.test.mjs && tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint src && npm run lint:styles && npm run architecture:check",
    "lint:styles": "node --test tooling/design-token-rule.test.mjs && stylelint \"src/**/*.scss\"",
    "architecture:check": "node --test ../scripts/check-frontend-architecture.test.mjs && node ../scripts/check-frontend-architecture.mjs"
  },
  "private": true,
  "packageManager": "npm@12.1.0",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "dependencies": {
    "@angular/cdk": "22.2.2",
    "@angular/common": "22.2.2",
    "@angular/compiler": "22.2.2",
    "@angular/core": "22.2.2",
    "@angular/forms": "22.2.2",
    "@angular/platform-browser": "22.2.2",
    "@angular/platform-server": "22.2.2",
    "@angular/router": "22.2.2",
    "@angular/ssr": "22.2.2",
    "express": "^5.1.0",
    "rxjs": "7.8.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "22.6.0",
    "@angular-eslint/eslint-plugin-template": "22.6.0",
    "@angular-eslint/template-parser": "22.6.0",
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/compiler-cli": "22.2.2",
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.56.1",
    "@types/express": "^5.0.1",
    "@types/node": "^22.12.0",
    "axe-core": "^4.14.0",
    "eslint": "10.12.0",
    "js-yaml": "4.3.2",
    "jsdom": "^30.0.0",
    "postcss-scss": "4.0.9",
    "prettier": "^3.8.1",
    "stylelint": "17.16.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  }
}
