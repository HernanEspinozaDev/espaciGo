FROM mcr.microsoft.com/playwright:v1.56.1-noble@sha256:f1e7e01021efd65dd1a2c56064be399f3e4de00fd021ac561325f2bfbb2b837a

USER root
WORKDIR /workspace
RUN npm install --global npm@10.9.4 && npm install --no-save --package-lock=false @playwright/test@1.56.1
COPY playwright.config.cjs ./playwright.config.cjs
COPY e2e ./e2e
RUN chown -R pwuser:pwuser /workspace
USER pwuser
CMD ["npx", "playwright", "test", "--config=playwright.config.cjs"]
