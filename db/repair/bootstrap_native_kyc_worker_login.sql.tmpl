\set ON_ERROR_STOP on
\set ECHO none
BEGIN;
SET LOCAL lock_timeout='3s';
SET LOCAL statement_timeout='15s';
SELECT pg_catalog.pg_advisory_xact_lock(x'45535047'::int,x'4d494752'::int);
DO $guard$
DECLARE n bigint; lo integer; hi integer; fp text; worker oid; login oid;
BEGIN
 IF current_database()<>'espacigo_dms_stage_20261020'
 OR (SELECT oid FROM pg_catalog.pg_database WHERE datname=current_database())<>16388
 OR current_setting('server_version_num')<>'180006'
 OR session_user<>'postgres' OR current_user<>'postgres'
 OR inet_server_addr() IS NOT NULL THEN
  RAISE EXCEPTION 'native worker bootstrap target/session mismatch';
 END IF;
 SELECT count(*),min(version),max(version),
   encode(pg_catalog.sha256(convert_to(string_agg(format(E'%s %s %s\n',version,name,checksum),'' ORDER BY version),'UTF8')),'hex')
 INTO n,lo,hi,fp FROM public.schema_migrations;
 IF n<>94 OR lo<>1 OR hi<>94 OR fp<>'395d771da8da79a6926feeeb43d9b355ea47778d311dffc1dd420aa63549eb4b' THEN
  RAISE EXCEPTION 'native worker bootstrap requires exact reviewed V1..V94 ledger';
 END IF;
 SELECT oid INTO worker FROM pg_catalog.pg_roles WHERE rolname='espacigo_privacy_cleanup_worker'
 AND NOT rolcanlogin AND NOT rolsuper AND NOT rolcreatedb AND NOT rolcreaterole AND NOT rolinherit
 AND NOT rolreplication AND NOT rolbypassrls AND rolconnlimit=-1;
 IF worker IS NULL THEN RAISE EXCEPTION 'cleanup worker role contract mismatch'; END IF;
 IF EXISTS (SELECT 1 FROM pg_catalog.pg_roles WHERE rolname='espacigo_privacy_worker_login') THEN
  RAISE EXCEPTION 'refusing existing worker LOGIN; no alter, reset, or reuse';
 END IF;
 IF EXISTS (SELECT 1 FROM pg_catalog.pg_auth_members WHERE roleid=worker OR member=worker) THEN
  RAISE EXCEPTION 'cleanup worker has unexpected membership edge';
 END IF;
 IF EXISTS (SELECT 1 FROM pg_catalog.pg_shdepend WHERE refclassid='pg_authid'::regclass AND refobjid=worker
   AND (deptype<>'a' OR NOT (dbid=16388 OR (dbid=0 AND classid='pg_database'::regclass AND objid=16388)))) THEN
  RAISE EXCEPTION 'cleanup worker has ownership or dependencies outside the approved target';
 END IF;
 IF EXISTS (
   WITH actual AS (
     SELECT dbid,classid,deptype,count(*) AS n FROM pg_catalog.pg_shdepend
     WHERE refclassid='pg_authid'::regclass AND refobjid=worker GROUP BY dbid,classid,deptype
   ), expected(dbid,classid,deptype,n) AS (VALUES
     (16388::oid,'pg_class'::regclass::oid,'a'::"char",57::bigint),
     (16388::oid,'pg_namespace'::regclass::oid,'a'::"char",1::bigint),
     (16388::oid,'pg_proc'::regclass::oid,'a'::"char",6::bigint),
     (0::oid,'pg_database'::regclass::oid,'a'::"char",1::bigint)
   ), delta AS ((SELECT * FROM actual EXCEPT SELECT * FROM expected) UNION ALL (SELECT * FROM expected EXCEPT SELECT * FROM actual))
   SELECT 1 FROM delta
 ) THEN RAISE EXCEPTION 'cleanup worker dependency baseline mismatch'; END IF;
END
$guard$;
SET LOCAL log_statement='none';
SET LOCAL log_min_duration_statement=-1;
SET LOCAL log_min_duration_sample=-1;
SET LOCAL log_transaction_sample_rate=0;
SET LOCAL log_min_error_statement='panic';
CREATE ROLE espacigo_privacy_worker_login LOGIN NOINHERIT NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS CONNECTION LIMIT 2 PASSWORD '__SCRAM_VERIFIER__';
GRANT espacigo_privacy_cleanup_worker TO espacigo_privacy_worker_login WITH ADMIN FALSE, INHERIT FALSE, SET TRUE;
DO $verify$
DECLARE worker oid; login oid; n bigint;
BEGIN
 SELECT oid INTO worker FROM pg_catalog.pg_roles WHERE rolname='espacigo_privacy_cleanup_worker';
 SELECT oid INTO login FROM pg_catalog.pg_roles WHERE rolname='espacigo_privacy_worker_login' AND rolcanlogin AND NOT rolsuper AND NOT rolcreatedb AND NOT rolcreaterole AND NOT rolinherit AND NOT rolreplication AND NOT rolbypassrls AND rolconnlimit=2;
 IF login IS NULL OR (SELECT rolpassword FROM pg_catalog.pg_authid WHERE oid=login) IS NULL THEN RAISE EXCEPTION 'worker LOGIN postcondition failed'; END IF;
 SELECT count(*) INTO n FROM pg_catalog.pg_auth_members WHERE roleid=worker AND member=login AND grantor='postgres'::regrole AND NOT admin_option AND NOT inherit_option AND set_option;
 IF n<>1 OR (SELECT count(*) FROM pg_catalog.pg_auth_members WHERE roleid=worker OR member=worker)<>1
 OR (SELECT count(*) FROM pg_catalog.pg_auth_members WHERE roleid=login OR member=login)<>1 THEN RAISE EXCEPTION 'worker membership postcondition failed'; END IF;
 IF EXISTS (SELECT 1 FROM pg_catalog.pg_shdepend WHERE refclassid='pg_authid'::regclass AND refobjid=login) THEN
  RAISE EXCEPTION 'new worker LOGIN acquired unexpected object ownership or direct privileges';
 END IF;
END
$verify$;
__FINISH__
