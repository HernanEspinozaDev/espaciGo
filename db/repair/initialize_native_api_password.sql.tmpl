-- Initialize ONLY a missing password for the existing native development API login.
-- Render SCRAM verifier privately; never put the rendered file or values in Git/logs.
BEGIN;
DO $guard$
BEGIN
 IF current_database()<>'espacigo_dms_stage_20261020'
 OR (SELECT oid FROM pg_catalog.pg_database WHERE datname=current_database())<>16388
 OR current_setting('server_version_num')<>'180006'
 OR session_user<>'postgres' OR current_user<>'postgres' THEN
  RAISE EXCEPTION 'native API initial credential target/administrator mismatch';
 END IF;
 IF (SELECT count(*) FROM public.schema_migrations)<>88 OR (SELECT max(version) FROM public.schema_migrations)<>88 THEN
  RAISE EXCEPTION 'native API credential requires the reviewed V88 boundary';
 END IF;
 IF NOT EXISTS (SELECT 1 FROM pg_catalog.pg_authid WHERE rolname='espacigo_api_login' AND rolpassword IS NULL
 AND rolcanlogin AND NOT rolsuper AND NOT rolcreaterole AND NOT rolcreatedb AND NOT rolinherit
 AND NOT rolreplication AND NOT rolbypassrls) THEN
  RAISE EXCEPTION 'refusing to overwrite an existing password or unsafe API login';
 END IF;
 IF EXISTS (SELECT 1 FROM pg_catalog.pg_stat_activity WHERE usename='espacigo_api_login') THEN
  RAISE EXCEPTION 'native API credential refuses active API-login sessions';
 END IF;
END
$guard$;
ALTER ROLE espacigo_api_login PASSWORD '@@SCRAM_VERIFIER@@';
DO $verify$
BEGIN
 IF NOT EXISTS (SELECT 1 FROM pg_catalog.pg_authid WHERE rolname='espacigo_api_login' AND rolpassword IS NOT NULL) THEN
  RAISE EXCEPTION 'native API initial credential was not stored';
 END IF;
END
$verify$;
COMMIT;
