-- Render the two target tokens before execution; never run this template directly.
-- Opens only the V84/V85 CREATE and usuario(id) REFERENCES window.
BEGIN;
SET LOCAL lock_timeout='5s';
SET LOCAL statement_timeout='60s';
DO $gate$
DECLARE
    target_oid oid;
    owner_oid oid;
    api_oid oid;
    migrator_oid oid;
    schema_owner_oid oid;
    helper_oid oid;
    runtime_oid oid;
    history_count bigint;
    min_version bigint;
    max_version bigint;
    membership_count integer;
    create_acl_count integer;
    references_acl_count integer;
    public_owner oid;
BEGIN
    IF NOT pg_catalog.pg_try_advisory_xact_lock(1163087943, 1296648018) THEN
        RAISE EXCEPTION 'migration lock is held; refusing native V84/V85 authority preparation';
    END IF;
    SELECT oid INTO target_oid FROM pg_catalog.pg_database WHERE datname=current_database();
    SELECT oid INTO owner_oid FROM pg_catalog.pg_roles WHERE rolname='postgres' AND rolsuper;
    SELECT oid INTO api_oid FROM pg_catalog.pg_roles WHERE rolname='espacigo_api_login' AND rolcanlogin AND NOT rolsuper AND NOT rolcreaterole AND NOT rolcreatedb AND NOT rolreplication AND NOT rolbypassrls AND NOT rolinherit;
    SELECT oid INTO migrator_oid FROM pg_catalog.pg_roles WHERE rolname='espacigo_migrator_login' AND rolcanlogin AND NOT rolsuper AND NOT rolcreaterole AND NOT rolcreatedb AND NOT rolreplication AND NOT rolbypassrls AND NOT rolinherit;
    SELECT oid INTO schema_owner_oid FROM pg_catalog.pg_roles WHERE rolname='espacigo_schema_owner' AND NOT rolcanlogin AND NOT rolsuper AND NOT rolcreaterole AND NOT rolcreatedb AND NOT rolreplication AND NOT rolbypassrls AND NOT rolinherit;
    SELECT oid INTO helper_oid FROM pg_catalog.pg_roles WHERE rolname='espacigo_document_verification_fn' AND NOT rolcanlogin AND NOT rolsuper AND NOT rolcreaterole AND NOT rolcreatedb AND NOT rolreplication AND NOT rolbypassrls AND NOT rolinherit;
    SELECT oid INTO runtime_oid FROM pg_catalog.pg_roles WHERE rolname='espacigo_runtime' AND NOT rolcanlogin AND NOT rolsuper AND NOT rolcreaterole AND NOT rolcreatedb AND NOT rolreplication AND NOT rolbypassrls AND NOT rolinherit;
    SELECT nspowner INTO public_owner FROM pg_catalog.pg_namespace WHERE nspname='public';
    IF current_database() <> __NATIVE_TARGET_DATABASE__ OR target_oid <> __NATIVE_TARGET_OID__::oid
       OR current_user <> 'postgres' OR session_user <> 'postgres' OR owner_oid IS NULL
       OR current_setting('server_version_num')::integer <> 180006 OR inet_client_addr() IS NOT NULL
       OR api_oid IS NULL OR migrator_oid IS NULL OR schema_owner_oid IS NULL OR helper_oid IS NULL OR runtime_oid IS NULL
       OR public_owner=schema_owner_oid THEN
        RAISE EXCEPTION 'native V84/V85 target, peer administrator or restricted role contract differs';
    END IF;
    SELECT count(*), min(version), max(version) INTO history_count, min_version, max_version FROM public.schema_migrations;
    IF history_count NOT IN (83,84) OR min_version<>1 OR max_version<>history_count THEN
        RAISE EXCEPTION 'native V84/V85 preparation requires exact committed V1..V83 or V1..V84 ledger';
    END IF;
    SELECT count(*) INTO membership_count FROM pg_catalog.pg_auth_members
     WHERE roleid IN (api_oid,migrator_oid,schema_owner_oid,helper_oid,runtime_oid)
        OR member IN (api_oid,migrator_oid,schema_owner_oid,helper_oid,runtime_oid);
    IF membership_count<>3
       OR NOT EXISTS (SELECT 1 FROM pg_catalog.pg_auth_members WHERE roleid=runtime_oid AND member=api_oid AND NOT admin_option AND NOT inherit_option AND set_option)
       OR NOT EXISTS (SELECT 1 FROM pg_catalog.pg_auth_members WHERE roleid=schema_owner_oid AND member=migrator_oid AND NOT admin_option AND NOT inherit_option AND set_option)
       OR NOT EXISTS (SELECT 1 FROM pg_catalog.pg_auth_members WHERE roleid=helper_oid AND member=schema_owner_oid AND NOT admin_option AND NOT inherit_option AND set_option) THEN
        RAISE EXCEPTION 'native V84/V85 preparation requires the exact V81 role-membership graph';
    END IF;
    SELECT count(*) INTO create_acl_count FROM pg_catalog.pg_namespace n
      CROSS JOIN LATERAL pg_catalog.aclexplode(COALESCE(n.nspacl,pg_catalog.acldefault('n',n.nspowner))) acl
     WHERE n.nspname='public' AND acl.grantee=schema_owner_oid AND acl.privilege_type='CREATE';
    SELECT count(*) INTO references_acl_count FROM pg_catalog.pg_attribute a
      CROSS JOIN LATERAL pg_catalog.aclexplode(CASE WHEN cardinality(a.attacl)>0 THEN a.attacl ELSE NULL::aclitem[] END) acl
     WHERE a.attrelid='public.usuario'::regclass AND a.attname='id' AND NOT a.attisdropped AND acl.grantee=schema_owner_oid;
    IF pg_catalog.has_schema_privilege(schema_owner_oid,'public','CREATE') OR create_acl_count<>0
       OR pg_catalog.has_column_privilege(schema_owner_oid,'public.usuario','id','REFERENCES') OR references_acl_count<>0 THEN
        RAISE EXCEPTION 'native V84/V85 preparation requires a clean, closed authority baseline';
    END IF;
    IF history_count=83 THEN
        IF pg_catalog.to_regclass('public.identity_verification_attempts') IS NOT NULL
           OR pg_catalog.to_regclass('public.didit_webhook_inbox') IS NOT NULL THEN
            RAISE EXCEPTION 'native V84 objects exist before their migration';
        END IF;
    ELSE
        IF pg_catalog.to_regclass('public.identity_verification_attempts') IS NULL
           OR pg_catalog.to_regclass('public.didit_webhook_inbox') IS NULL
           OR EXISTS (SELECT 1 FROM public.identity_verification_attempts)
           OR EXISTS (SELECT 1 FROM public.didit_webhook_inbox) THEN
            RAISE EXCEPTION 'native V85 preparation requires the empty V84 baseline';
        END IF;
    END IF;
END;
$gate$;
GRANT CREATE ON SCHEMA public TO espacigo_schema_owner;
GRANT REFERENCES(id) ON TABLE public.usuario TO espacigo_schema_owner;
DO $postcheck$
DECLARE
    schema_owner_oid oid;
    owner_oid oid;
    public_owner oid;
    create_grants integer;
    reference_grants integer;
BEGIN
    SELECT oid INTO schema_owner_oid FROM pg_catalog.pg_roles WHERE rolname='espacigo_schema_owner';
    SELECT relowner INTO owner_oid FROM pg_catalog.pg_class WHERE oid='public.usuario'::regclass;
    SELECT nspowner INTO public_owner FROM pg_catalog.pg_namespace WHERE nspname='public';
    SELECT count(*) INTO create_grants FROM pg_catalog.pg_namespace n
      CROSS JOIN LATERAL pg_catalog.aclexplode(COALESCE(n.nspacl,pg_catalog.acldefault('n',n.nspowner))) acl
     WHERE n.nspname='public' AND acl.grantee=schema_owner_oid AND acl.grantor=public_owner
       AND acl.privilege_type='CREATE' AND NOT acl.is_grantable;
    SELECT count(*) INTO reference_grants FROM pg_catalog.pg_attribute a
      CROSS JOIN LATERAL pg_catalog.aclexplode(CASE WHEN cardinality(a.attacl)>0 THEN a.attacl ELSE NULL::aclitem[] END) acl
     WHERE a.attrelid='public.usuario'::regclass AND a.attname='id' AND NOT a.attisdropped
       AND acl.grantee=schema_owner_oid AND acl.grantor=owner_oid
       AND acl.privilege_type='REFERENCES' AND NOT acl.is_grantable;
    IF create_grants<>1 OR reference_grants<>1
       OR NOT pg_catalog.has_schema_privilege(schema_owner_oid,'public','CREATE')
       OR NOT pg_catalog.has_column_privilege(schema_owner_oid,'public.usuario','id','REFERENCES') THEN
        RAISE EXCEPTION 'native V84/V85 bounded authority window failed readback';
    END IF;
END;
$postcheck$;
COMMIT;
