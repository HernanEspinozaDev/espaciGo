#!/usr/bin/env bash
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
cd "$root"
remote_url="${2:-}"
case "$remote_url" in
  https://github.com/HernanEspinozaDev/espaciGo|https://github.com/HernanEspinozaDev/espaciGo.git) ;;
  *) echo 'Push rechazado: usa el remoto HTTPS verificado de HernanEspinozaDev/espaciGo.' >&2; exit 1 ;;
esac

while read -r local_ref local_sha remote_ref remote_sha; do
  branch="${remote_ref#refs/heads/}"
  if [[ "$remote_ref" != refs/heads/* || "$local_sha" =~ ^0+$ ]]; then
    echo 'Push rechazado: este flujo publica ramas de desarrollo; tags o borrados requieren una operación administrativa explícita.' >&2
    exit 1
  fi
  if [[ ! "$branch" =~ ^codex/(marketplace|backend|frontend|database|infra|docs)/(feature|fix|chore)/(mpv2-[0-9]{2}|[a-z][a-z0-9]*-[0-9]+)-[a-z0-9]+(-[a-z0-9]+)*$ ]]; then
    echo 'Push rechazado: usa codex/<área>/<tipo>/<corte>-<descripción>; main se actualiza por PR.' >&2
    exit 1
  fi
done
"$root/scripts/git-role.sh" check-development
