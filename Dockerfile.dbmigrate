# Pin the exact linux/amd64 builder manifest; update only with a reviewed toolchain change.
FROM golang:1.27.1-alpine3.24@sha256:cd9a32216aee5667f957a62d13a10032a63fd58e14b3f3d9cc8c2122f501e95e AS build

ARG SOURCE_DATE_EPOCH
ENV CGO_ENABLED=0 \
    GOTOOLCHAIN=local \
    GOOS=linux \
    GOARCH=amd64
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/gcp03scratch ./cmd/gcp03scratch
COPY internal/gcp03scratch ./internal/gcp03scratch
COPY internal/database/cloudsql ./internal/database/cloudsql
COPY internal/dbbootstrap ./internal/dbbootstrap
COPY internal/migrator ./internal/migrator
# This GCP-03 scratch executor is pinned to its historical V1-V61 contract.
COPY db/migrations/V00000[1-9]__*.sql db/migrations/V0000[1-5][0-9]__*.sql db/migrations/V000060__*.sql db/migrations/V000061__*.sql /out/migrations/
COPY db/bootstrap/gcp03scratch ./db/bootstrap/gcp03scratch
RUN go build -trimpath -buildvcs=false -ldflags='-s -w' -o /out/gcp03scratch ./cmd/gcp03scratch

FROM scratch
WORKDIR /app
COPY --from=build /out/gcp03scratch /app/gcp03scratch
COPY --from=build /out/migrations /app/db/migrations
# Use the CA bundle from the pinned builder image for the connector's HTTPS control plane.
COPY --from=build /etc/ssl/cert.pem /etc/ssl/cert.pem
USER 65532:65532
ENTRYPOINT ["/app/gcp03scratch"]
