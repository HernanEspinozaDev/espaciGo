FROM golang:1.27.1-alpine3.24@sha256:cd9a32216aee5667f957a62d13a10032a63fd58e14b3f3d9cc8c2122f501e95e AS build
WORKDIR /src
RUN apk add --no-cache ca-certificates
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN mkdir -p /out/tmp \
    && chmod 1777 /out/tmp \
    && CGO_ENABLED=0 GOOS=linux go test -c -trimpath -o /out/gcp04-replay-smoke ./internal/adapters/postgres/identity

FROM scratch
COPY --from=build --chown=65532:65532 /out/gcp04-replay-smoke /gcp04-replay-smoke
COPY --from=build /out/tmp /tmp
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /src/db/migrations /src/db/migrations
WORKDIR /src/internal/adapters/postgres/identity
USER 65532:65532
ENTRYPOINT ["/gcp04-replay-smoke"]
