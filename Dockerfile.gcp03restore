# Build the reviewed one-shot executor with the repository's pinned toolchain.
FROM golang:1.27.1-alpine3.24@sha256:cd9a32216aee5667f957a62d13a10032a63fd58e14b3f3d9cc8c2122f501e95e AS build

ENV CGO_ENABLED=0 GOTOOLCHAIN=local GOOS=linux GOARCH=amd64
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/gcp03restore ./cmd/gcp03restore
COPY internal/gcp03restore ./internal/gcp03restore
COPY internal/dbbootstrap ./internal/dbbootstrap
COPY internal/database/cloudsql ./internal/database/cloudsql
COPY internal/migrator ./internal/migrator
COPY db/migrations ./db/migrations
RUN go build -trimpath -buildvcs=false -ldflags='-s -w' -o /out/gcp03restore ./cmd/gcp03restore

# This pinned PostGIS image provides PostgreSQL 18's pg_restore binary. The
# database server entrypoint is never used by the Cloud Run job.
FROM postgis/postgis:18-3.6@sha256:60f6ad1d21ea86a67d47780b9a0d1e1d200500f62b19293fa834d0dea80b8677
COPY --from=build /out/gcp03restore /app/gcp03restore
COPY --from=build /src/db/migrations /app/db/migrations
USER 65532:65532
ENTRYPOINT ["/app/gcp03restore"]
